# ── General ────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=UTC

# ── Docker Compose ─────────────────────────────────────────────────────
# Perfil s3: arranca MinIO y su copia. Vacío con STORAGE_DRIVER=local o con un S3 externo.
# OJO: MinIO ya no publica sus imágenes oficiales (minio/minio, minio/mc); antes de activarlo
# hay que cambiar la imagen en docker-compose.yml por una que exista.
# COMPOSE_PROFILES=s3
# En un servidor con el proxy inverso en otro contenedor (ver docker-compose.proxy.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=hr-core-proxy

# ── PostgreSQL + PostGIS ───────────────────────────────────────────────
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr_dev_password
POSTGRES_DB=hr_gestion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hr:hr_dev_password@localhost:5432/hr_gestion?schema=public

# ── Instalación ─────────────────────────────────────────────────────────
# demo: la demo pública (sin registro ni correo; se restablece cada noche).
# client: servidor de un cliente (una empresa; solo se entra con invitación).
# open: registro libre con verificación del correo.
DEPLOY_MODE=open
# Solo en modo demo: dominio de las cuentas de prueba (por defecto demo.example.com).
# DEMO_EMAIL_DOMAIN=demo.example.com

# Carpeta donde se publica, sin barra final (p. ej. /HR-core). Vacía = raíz del dominio.
# La web se compila con la misma ruta en VITE_BASE_PATH.
BASE_PATH=
VITE_BASE_PATH=
# En modo open: required exige confirmar el correo antes de crear empresas o invitar.
EMAIL_VERIFICATION=required
# Contraseña de las cuentas de la demo (solo DEPLOY_MODE=demo; se publica en la web).
DEMO_PASSWORD=Demo-HRCore-2026
# Tareas programadas: avisos, recordatorios y reinicio de la demo.
JOBS_ENABLED=true
JOBS_TIMEZONE=Europe/Madrid
# Intentos fallidos antes de bloquear una cuenta, y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Invitaciones por correo que puede enviar cada empresa en 24 h (alta masiva incluida).
INVITES_PER_DAY=200

# ── Datos legales del responsable del sitio (aviso legal y privacidad) ──
# Sin LEGAL_NAME, las páginas legales avisan de que faltan los datos.
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Proveedor tecnológico (encargado del tratamiento), si no es el propio responsable.
LEGAL_PROVIDER=
# Subencargados de esta instalación para el encargo de tratamiento, separados por «;».
# LEGAL_SUBPROCESSORS=Hetzner Online GmbH (alojamiento de los servidores; Alemania)

# ── Copias de seguridad (servicios backup-db y backup-files) ───────────
BACKUP_DIR=./backups
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14

# ── Almacenamiento S3 (MinIO en local; S3/R2 en producción) ────────────
# local (disco del servidor, sin MinIO) o s3 (AWS S3, R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hr_minio
S3_SECRET_KEY=hr_minio_dev_secret
S3_BUCKET=hr-gestion
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── API ────────────────────────────────────────────────────────────────
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# 5173: desarrollo · 4173: `pnpm --filter @hr/web preview` (compilado, con service worker)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
# Límites de peticiones por minuto y por IP
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Web Push (generar con: npx web-push generate-vapid-keys) ───────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Mapas y direcciones (OpenStreetMap; sustituibles por instancias propias) ──
GEOCODER_URL=https://nominatim.openstreetmap.org
# Nominatim pide identificar la aplicación; en producción pon aquí un contacto.
GEOCODER_USER_AGENT=hr-gestion/0.1
# Si la API sale a internet a través de un proxy (HTTPS_PROXY), actívalo con:
# NODE_USE_ENV_PROXY=1
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Correo ─────────────────────────────────────────────────────────────
# smtp: cualquier servidor de correo (el de tu empresa, Gmail, Microsoft 365, tu hosting…).
# resend: la API de Resend, con un dominio verificado. log: no se envía nada, solo se escribe en el log.
EMAIL_DRIVER=log
# SMTP. Puerto 587 con STARTTLS (lo habitual) o 465 con TLS directo. Sin cifrado no se envía,
# salvo que pongas SMTP_REQUIRE_TLS=false (solo para un relé en la misma máquina o red privada).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Resend: clave con permiso de envío.
RESEND_API_KEY=
EMAIL_FROM=HR-Core <no-reply@tu-dominio.es>
EMAIL_REPLY_TO=
# URL pública de la web, con su ruta base: se usa en los enlaces de los correos.
APP_PUBLIC_URL=http://localhost:5173

# ── OCR de tickets: "mock" hasta conectar un proveedor real ────────────
OCR_PROVIDER=mock

# ── Web ────────────────────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_URL=http://localhost:3000/api/v1
# Nombre de la app en esta instalación (título, app instalada y pantallas). Vacío = HR-Core.
# APP_NAME=HR-Core
# Versión de las imágenes publicadas (latest o una concreta, p. ej. 1.0.0).
# HR_CORE_VERSION=latest

