# Respuestas para instalar.sh sin preguntas. Copia este archivo a configuracion.env, rellénalo y ejecuta
# ./instalar/instalar.sh. Lo que dejes vacío se pregunta por pantalla.
# Answers for instalar.sh. Copy to configuracion.env, fill it in and run ./instalar/instalar.sh.
# Anything left empty is asked on screen.

# dominio | tailscale | local
ACCESO=dominio
# Solo con ACCESO=dominio, sin https:// / Only with ACCESO=dominio, without https://
DOMINIO=fichajes.tuempresa.es
# Solo con tailscale o local: puerto en 127.0.0.1 / Only with tailscale or local: port on 127.0.0.1
PUERTO_LOCAL=8080

EMPRESA_NOMBRE=
EMPRESA_NIF=
EMPRESA_DIRECCION=
EMPRESA_CORREO=
ADMIN_NOMBRE=
ADMIN_CORREO=
NOMBRE_APP=HR-Core
ZONA_HORARIA=Europe/Madrid

# smtp | resend | ninguno
CORREO=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# La contraseña SMTP o la clave de Resend se pueden dejar vacías: el instalador las pide sin mostrarlas.
# The SMTP password or Resend key can be left empty: the installer asks for them without echoing.
SMTP_PASSWORD=
RESEND_API_KEY=
CORREO_REMITENTE=Fichajes <no-reply@tuempresa.es>

# Copias diarias / daily backups
CARPETA_COPIAS=/var/backups/hr-core
DIAS_COPIAS=14

# Versión de las imágenes (latest o p. ej. 1.0.0) / Image version
HR_CORE_VERSION=latest
